<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 长按图标快捷方式（res/xml/shortcuts.xml）：今日 / 本周 / 作业。
                 action → view 的映射在 MainActivity.viewFromAction()。 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="dev.lut.timetable.OPEN_TODAY" />
                <action android:name="dev.lut.timetable.OPEN_WEEK" />
                <action android:name="dev.lut.timetable.OPEN_ASSIGN" />
            </intent-filter>

            <!-- Moodle SSO login kembali: launch.php mengarahkan ke
                 lut-timetable://token=... setelah SSO+Duo selesai di browser.
                 moodlemobile:// (skema bawaan resmi) juga diterima karena
                 situs bisa memaksa lewat tool_mobile | forcedurlscheme —
                 token tetap diverifikasi md5(passport) milik kita. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lut-timetable" />
                <data android:scheme="moodlemobile" />
            </intent-filter>

        </activity>

        <!-- Home-screen widget: today's lessons (data from CapacitorStorage). -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- Widget varian 4×2 (dua kolom + countdown), mesin render sama. -->
        <receiver
            android:name=".WideWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_wide_info" />
        </receiver>

        <!-- Widget tugas: deadline terdekat dulu, tap membuka halaman tugas. -->
        <service
            android:name=".WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 后台刷新：JobScheduler 周期性跑一次隐藏 WebView（?bg=1），让小组件与
             提醒的数据在不开 App 时也保持新鲜。载荷契约不变（widget_payload_v1）。 -->
        <service
            android:name=".BackgroundSyncJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Checkbox centang di widget tugas: antre toggle untuk web + gambar
             ulang widget. exported=false cukup, PendingIntent aplikasi sendiri. -->
        <receiver
            android:name=".WidgetToggleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.lut.timetable.WIDGET_TOGGLE_TASK" />
                <action android:name="dev.lut.timetable.WIDGET_OPEN_LESSON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TasksWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tasks_info" />
        </receiver>


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 后台刷新任务带了「需要网络」约束（JobInfo.setRequiredNetworkType）；
         JobScheduler.schedule 会直接抛 SecurityException 而不只是拒绝。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Exact alarms keep the 10-min lesson & 24h/1h deadline reminders
         firing on time under Doze (Android 12+). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 后台刷新任务重启后仍然有效（JobInfo.setPersisted(true) 要求） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
</manifest>
