<?xml version="1.0" encoding="utf-8"?>
<!-- Widget tugas: deadline terdekat dulu. keyguard = tampil juga di layar
     kunci (Android 16+) — mesin render punya jalur kontras tinggi untuk itu. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_tasks"
    android:previewLayout="@layout/widget_tasks"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen|keyguard" />
